{
  "uid": "adp-admission",
  "title": "Adaptive DB Pool / Admission Control",
  "tags": [
    "adaptive-db-pool"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Now",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_admission_active",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Waiting in Queue",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_admission_waiting",
          "legendFormat": "waiting"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Current Limit",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_admission_limit",
          "legendFormat": "limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Admissions / s",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(adaptive_db_pool_admission_wait_seconds_count[1m])",
          "legendFormat": "admitted/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Active vs Waiting",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_admission_active",
          "legendFormat": "active"
        },
        {
          "expr": "adaptive_db_pool_admission_waiting",
          "legendFormat": "waiting"
        }
      ],
      "description": "Active mendekati limit = kontrol bekerja. Waiting tinggi terus = limit terlalu kecil.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Limit Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_admission_limit",
          "legendFormat": "limit"
        }
      ],
      "description": "Step view: tiap anak tangga = satu keputusan controller.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Admission Wait Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(adaptive_db_pool_admission_wait_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(adaptive_db_pool_admission_wait_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(adaptive_db_pool_admission_wait_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "description": "Berapa lama request menunggu slot admission sebelum dieksekusi.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "Limit Changes (per 5m)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(adaptive_db_pool_controller_limit_changes_total[5m]))",
          "legendFormat": "changes/5m"
        },
        {
          "expr": "changes(adaptive_db_pool_admission_limit[5m])",
          "legendFormat": "distinct limit values (5m)"
        }
      ],
      "description": "Osilasi: nilai yang naik-turun cepat tanpa arah jelas = controller tidak stabil (RQ4/RQ5).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    }
  ]
}