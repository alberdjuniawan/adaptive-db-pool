{
  "uid": "adp-database",
  "title": "Adaptive DB Pool / Database Pool",
  "tags": [
    "adaptive-db-pool"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Acquired Conns",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_db_pool_acquired_connections",
          "legendFormat": "acquired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Idle Conns",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_db_pool_idle_connections",
          "legendFormat": "idle"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Max Conns",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_db_pool_max_connections",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pool Utilization",
      "type": "gauge",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_db_pool_acquired_connections / adaptive_db_pool_db_pool_max_connections",
          "legendFormat": "utilization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Pool Connections (max / acquired / idle)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "expr": "adaptive_db_pool_db_pool_max_connections",
          "legendFormat": "max"
        },
        {
          "expr": "adaptive_db_pool_db_pool_acquired_connections",
          "legendFormat": "acquired"
        },
        {
          "expr": "adaptive_db_pool_db_pool_idle_connections",
          "legendFormat": "idle"
        }
      ],
      "description": "Pool fisik pgxpool sengaja statis (AGENT.md rule 11); yang adaptif adalah admission logikal.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Connection Wait Pressure",
      "type": "timeseries",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(adaptive_db_pool_db_pool_wait_seconds[1m])",
          "legendFormat": "wait s/s"
        }
      ],
      "description": "Kecepatan akumulasi waktu tunggu koneksi pool; > 0 stabil = aplikasi lebih cepat dari pool.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Query Latency p95 by Class",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(adaptive_db_pool_request_duration_seconds_bucket[1m])) by (le, query_class))",
          "legendFormat": "{{query_class}}"
        }
      ],
      "description": "Latensi ekor per kelas workload; kompleks & agregat dominan karena mahal secara SQL.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    }
  ]
}