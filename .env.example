# Backend API
PORT=8080
APP_ENV=development

# PostgreSQL (inside Docker Compose network use host "postgres")
DATABASE_URL=postgres://adaptive:adaptive@localhost:5432/adaptive?sslmode=disable

# pgxpool physical pool configuration (NOT adaptive in baseline research phase)
DB_MAX_CONNS=50
DB_MIN_CONNS=2

# Logical admission control (primary control variable)
ADMISSION_STRATEGY=static
ADMISSION_LIMIT=20

# Telemetry
PROMETHEUS_ENABLED=true

# PostgreSQL container credentials
POSTGRES_USER=adaptive
POSTGRES_PASSWORD=adaptive
POSTGRES_DB=adaptive
